{
  "name": "cfb-dynasty",
  "private": true,
  "description": "OOTP-style college football management game built on the CFB Sim play-by-play engine",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:parity": "vitest run packages/engine/test/parity.test.ts",
    "dev": "npm run dev -w @cfb/server & npm run dev -w @cfb/client",
    "start": "npm run build -w @cfb/client && npm run start -w @cfb/server",
    "play": "node scripts/launch.mjs",
    "install-app": "node scripts/install-app.mjs",
    "league:new": "tsx packages/server/src/cli.ts new",
    "season:run": "tsx packages/server/src/cli.ts run-season",
    "bench": "tsx packages/engine/bench.ts",
    "results:check": "tsx packages/core/scripts/results-check.ts",
    "seed:power": "tsx packages/core/scripts/power.ts",
    "seed:players": "tsx packages/core/scripts/rate-players.ts",
    "check:seasons": "tsx packages/core/scripts/season-counts.ts",
    "replay:2025": "tsx packages/core/scripts/replay-2025.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
